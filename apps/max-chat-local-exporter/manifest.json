{
  "manifest_version": 3,
  "name": "MAX Chat Local Exporter",
  "version": "8.2.10.849",
  "description": "Локальный экспорт подгруженной переписки MAX: сообщения, reply, ссылки на сообщения, картинки и автоназвание ZIP с количеством сообщений/вложений.",
  "action": {
    "default_title": "MAX Chat Exporter",
    "default_popup": "popup.html"
  },
  "permissions": [
    "activeTab",
    "downloads",
    "storage",
    "unlimitedStorage"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; worker-src 'self'"
  },
  "host_permissions": [
    "https://web.max.ru/*",
    "https://*.max.ru/*",
    "https://*.oneme.ru/*",
    "https://*.okcdn.ru/*",
    "https://script.google.com/*",
    "https://script.googleusercontent.com/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://web.max.ru/*"
      ],
      "js": [
        "ocr_host_client.js",
        "ocr_bridge_policy.js",
        "message_identity.js",
        "media_identity.js",
        "panel_ui.js",
        "panel_motion.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://frankiej13.github.io/leadbridge-kso/*"
      ],
      "js": [
        "leadbridge_handoff_client.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "ocr_host.html"
      ],
      "matches": [
        "https://web.max.ru/*"
      ]
    },
    {
      "resources": [
        "handoff_host.html"
      ],
      "matches": [
        "https://frankiej13.github.io/*"
      ]
    }
  ]
}
